{
    "name": "wobqqq/october-cms-sandbox",
    "description": "An empty October CMS project for installing and testing plugins",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "october/all": "^4.4",
        "october/backend": "^4.4",
        "october/cms": "^4.4",
        "october/dashboard": "^4.4",
        "october/editor": "^4.4",
        "october/media": "^4.4",
        "october/rain": "^4.4",
        "october/system": "^4.4",
        "october/tailor": "^4.4"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.0",
        "ergebnis/composer-normalize": "^2.48",
        "friendsofphp/php-cs-fixer": "^3.88",
        "j13k/yaml-lint": "^1.1",
        "larastan/larastan": "^3.7",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.1",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.2",
        "wobqqq/oc-ide-helper": "^2.2"
    },
    "repositories": {
        "octobercms": {
            "only": [
                "october/*",
                "*-plugin",
                "*-theme"
            ],
            "type": "composer",
            "url": "https://gateway.octobercms.com"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "System\\Console\\": "modules/system/console"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "post-update-cmd": [
            "System\\Console\\ComposerScript::postUpdateCmd"
        ],
        "pre-package-uninstall": [
            "System\\Console\\ComposerScript::prePackageUninstall"
        ],
        "post-autoload-dump": [
            "System\\Console\\ComposerScript::postAutoloadDump"
        ],
        "code.check": [
            "@composer validate --strict --no-check-all",
            "@composer normalize --dry-run",
            "@composer audit --abandoned=report",
            "@code.yaml.check",
            "@code.cs.check",
            "@code.rector.check",
            "@code.stan"
        ],
        "code.cs.check": "php-cs-fixer fix --diff --dry-run",
        "code.cs.fix": "php-cs-fixer fix --diff",
        "code.fix": [
            "@composer normalize --no-update-lock",
            "@code.cs.fix",
            "@code.rector.fix"
        ],
        "code.ide": [
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ],
        "code.rector.check": "rector process --dry-run",
        "code.rector.fix": "rector process",
        "code.stan": "phpstan analyse --memory-limit=1G",
        "code.yaml.check": "yaml-lint docker-compose.yaml themes/sandbox/theme.yaml",
        "ready": [
            "@code.fix",
            "@code.check",
            "@test.coverage"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest"
        ],
        "test.coverage": [
            "@php artisan config:clear --ansi",
            "@php -d pcov.enabled=1 -d pcov.directory=app vendor/bin/pest --coverage --min=90"
        ]
    }
}
